<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Основная база -->
		<add name="Db1"
			 providerName="System.Data.SqlClient"
			 connectionString="Data Source=localhost;Initial Catalog=StudentGrades1;Integrated Security=SSPI;" />
		<!-- Вторая база для смены источника -->
		<add name="Db2"
			 providerName="System.Data.SqlClient"
			 connectionString="Data Source=localhost;Initial Catalog=StudentGrades2;Integrated Security=SSPI;" />
	</connectionStrings>
</configuration>